"""One-off: move runs/boxteacher_smoke -> runs_archive/boxteacher_smoke_20261027 on tcd04-tierb-vol
(rename, nothing deleted), verifying the file list and sizes are identical before and after."""
import modal

app = modal.App("tcd04-tierb-archive-smoke")
vol = modal.Volume.from_name("tcd04-tierb-vol")
SRC, DST = "/vol/runs/boxteacher_smoke", "/vol/runs_archive/boxteacher_smoke_20261027"


def listing(root):
    import os
    out = {}
    for d, _, fs in os.walk(root):
        for f in fs:
            p = os.path.join(d, f)
            out[os.path.relpath(p, root)] = os.path.getsize(p)
    return out


@app.function(volumes={"/vol": vol}, cpu=1, memory=1024, timeout=600)
def move():
    import os
    vol.reload()
    assert os.path.isdir(SRC), f"missing {SRC}"
    assert not os.path.exists(DST), f"REFUSING: {DST} exists"
    before = listing(SRC)
    os.makedirs(os.path.dirname(DST), exist_ok=True)
    os.rename(SRC, DST)
    after = listing(DST)
    assert before == after, "listing changed"
    assert not os.path.exists(SRC)
    vol.commit()
    return {"files": len(before), "bytes": sum(before.values()), "identical": True,
            "sample": sorted(before)[:40]}


@app.local_entrypoint()
def main():
    import json
    print(json.dumps(move.remote(), indent=1))
