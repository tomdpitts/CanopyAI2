{
    // Keep the file watcher off the big dataset/cache trees — training jobs
    // write thousands of files per hour here, overflowing FSEvents and
    // forcing VS Code to rescan the whole 90 GB workspace.
    "files.watcherExclude": {
        "**/.venv/**": true,
        "**/data/**": true,
        "**/tmp/**": true,
        "**/claude_outputs/**": true,
        "**/boxinst_tcd/cache/**": true,
        "**/boxinst_tcd/tiles/**": true,
        "**/boxinst_tcd/canopy_masks/**": true,
        "**/dapt/cache/**": true,
        "**/dino/efficiency/cache/**": true
    },
    "search.exclude": {
        "**/.venv/**": true,
        "**/data/tcd/**": true,
        "**/data/finetune/**": true,
        "**/data/jansen/**": true,
        "**/tmp/**": true,
        "**/claude_outputs/**": true,
        "**/boxinst_tcd/cache/**": true,
        "**/boxinst_tcd/tiles/**": true,
        "**/dapt/cache/**": true,
        "**/dino/efficiency/cache/**": true
    },
    "python.analysis.exclude": [
        "**/.venv",
        "data/tcd",
        "data/finetune",
        "data/jansen",
        "tmp",
        "claude_outputs",
        "boxinst_tcd/cache",
        "boxinst_tcd/tiles",
        "dapt/cache",
        "dino/efficiency/cache"
    ],
    // LaTeX Workshop (overrides the user-level recipe in this workspace only): build paper.tex (MDPI) with tectonic.
    // 2026-11-16: the CVPR on-save hook (cvpr/on_save.sh, tool "cvpr-sync") was retired; CVPR and arXiv v2 are
    // manual now: python3 cvpr/make_cvpr.py && python3 arxiv_v2/make_arxiv_v2.py
    "latex-workshop.latex.tools": [
        { "name": "tectonic", "command": "tectonic",
          "args": ["--synctex", "--keep-logs", "%DOC%.tex"], "env": {} }
    ],
    "latex-workshop.latex.recipes": [
        { "name": "tectonic", "tools": ["tectonic"] }
    ],
    "latex-workshop.latex.recipe.default": "tectonic"
}
