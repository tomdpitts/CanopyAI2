boxinst_commonality_tcd_04/confidence/preds_*_product.json
#   - _ap_cache_s0.pkl  score-invariant mask-IoU cache, rebuilt by confidence/ablation.py
boxinst_commonality_tcd_04/confidence/_ap_cache_s0.pkl

